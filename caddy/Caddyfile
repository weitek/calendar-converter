# Caddy reverse proxy configuration (без SSL для локальной разработки)

:80 {
    # Проксирование статики frontend
    reverse_proxy frontend:80

    # API запросы к backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Health check
    handle /health {
        reverse_proxy backend:8000
    }
}

# Для HTTPS раскомментируйте и настройте домен:
# example.com {
#     root * /usr/share/nginx/html
#     file_server
#
#     handle /api/* {
#         reverse_proxy backend:8000
#     }
#
#     handle /health {
#         reverse_proxy backend:8000
#     }
#
#     # HTTPS автоматически через Let's Encrypt
# }
