# Caddy reverse proxy configuration

:80 {
    root * /usr/share/nginx/html
    file_server

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /health {
        reverse_proxy backend:8000
    }

    handle_errors {
        @404 {
            expression {http.error.status_code} == 404
        }
        handle @404 {
            file_server
        }
    }
}

# Для HTTPS раскомментируйте и настройте домен:
# example.com {
#     root * /usr/share/nginx/html
#     file_server
#
#     handle /api/* {
#         reverse_proxy backend:8000
#     }
#
#     handle /health {
#         reverse_proxy backend:8000
#     }
#
#     # HTTPS автоматически через Let's Encrypt
